    </Data>
    <Data name="ext_expires">
     <value>2026-09-27T02:30:00-04:00</value>
    </Data>
    <Data name="ext_areaDesc">
     <value>Waters from Eastport ME to Schoodic Point ME from 25 to 60 NM or the Hague Line; Waters from Schoodic Point ME to Stonington ME from 25 to 60 NM</value>
